{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*"],
      "matchStrings": [
        "#\\s*renovate-regex:\\s*datasource=(?<datasource>\\S+)\\s+packageName=(?<packageName>\\S+)(\\s+registryUrl=(?<registryUrl>\\S+))?\\n.*[A-Z_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "regex:(?<major>[0-9]+)([^0-9]+(?<minor>[0-9]+))?([^0-9]+(?<patch>[0-9]+))?([^0-9]+(?<build>[0-9]+))?([^0-9]+(?<revision>[0-9]+))?"
    }
  ],
  "customDatasources": {
    "version": {
      "defaultRegistryUrlTemplate": "https://home.mihaiush.ro/cgi-bin/{{packageName}}-version",
      "format": "plain"
    }
  },
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["*"],
      "automerge": true
    }
  ]
}
